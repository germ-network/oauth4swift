# npm-audience settings only. pnpm's own settings live in pnpm-workspace.yaml
# .npmrc is read for auth and registry settings only, and when someone
# accidentally invokes npm

# engines.npm >= 12 is a tripwire, not an endorsement: pnpm is the standard, but
# if a person or agentic tool reaches for npm anyway, engine-strict makes the
# install refuse and exit. This means people and agents will land on a version
# with secure defaults instead of silently installing unsafely with an outdated
# npm.
engine-strict=true
